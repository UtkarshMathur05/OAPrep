# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) column in database/init/01_schema.sql
EMBEDDING_DIM=768

# Disk cache for every Gemini call (ai/cache.py). Keeps the demo instant,
# deterministic and offline. Set to 1 while tuning prompts, or you will keep
# getting yesterday's answer.
MEMOIZE_NO_CACHE=
# Override where cached responses live (default: ai/.cache/)
MEMOIZE_CACHE_DIR=

# ---- PostgreSQL (matches docker-compose.yml) ----
POSTGRES_USER=recollect
POSTGRES_PASSWORD=recollect
POSTGRES_DB=recollect
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recollect:recollect@localhost:5432/recollect
# Seconds before a down Postgres fails instead of hanging the request
DB_CONNECT_TIMEOUT=5

# ---- Judge0 ----
# Public CE instance: https://ce.judge0.com  (no key)
# RapidAPI instance:  https://judge0-ce.p.rapidapi.com (needs key + host)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true to return canned data instead of calling Gemini/Judge0
USE_MOCK_AI=true

# ---- Frontend (Vite: only VITE_* is exposed to the browser) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=true
