# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) column in database/init/01_schema.sql
EMBEDDING_DIM=768

# Disk cache for every Gemini call (ai/cache.py). Keeps the demo instant,
# deterministic and offline. Set to 1 while tuning prompts, or you will keep
# getting yesterday's answer.
MEMOIZE_NO_CACHE=
# Override where cached responses live (default: ai/.cache/)
MEMOIZE_CACHE_DIR=

# ---- PostgreSQL (matches docker-compose.yml) ----
POSTGRES_USER=recollect
POSTGRES_PASSWORD=recollect
POSTGRES_DB=recollect
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recollect:recollect@localhost:5432/recollect
# Seconds before a down Postgres fails instead of hanging the request
DB_CONNECT_TIMEOUT=5

# ---- Judge0 ----
# Public CE instance: https://ce.judge0.com  (no key)
# RapidAPI instance:  https://judge0-ce.p.rapidapi.com (needs key + host)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true to return canned data instead of calling Gemini/Judge0
USE_MOCK_AI=true

# ---- Accounts ----
# Everything below works out of the box for local development. Only AUTH_SECRET
# and EMAIL_PROVIDER genuinely have to change before anybody but you uses this;
# the backend logs a warning at boot for each one that is still a dev default.

# Signs the session cookie, the OAuth state and the emailed links. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out and voids outstanding links, which is the
# right response to it leaking.
AUTH_SECRET=
SESSION_COOKIE=memoize_session
SESSION_TTL_DAYS=30

# Where the browser and the API are. Both are used literally: an OAuth redirect
# URI must match what is registered with the provider byte for byte, and email
# links point at the app, not the API.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# Derived from PUBLIC_APP_URL being https; override only if TLS terminates
# elsewhere. COOKIE_SAMESITE must become "none" (which forces secure) if the app
# and API end up on different registrable domains.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# OAuth. Both are free to register and optional — with neither set, only email
# and password sign-in is offered.
#   GitHub: Settings > Developer settings > OAuth Apps.
#           Callback URL: {PUBLIC_API_URL}/api/auth/github/callback
#   Google: console.cloud.google.com > Credentials > OAuth client ID (Web).
#           Redirect URI: {PUBLIC_API_URL}/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console | resend | smtp
# "console" prints verification and reset links to the server log, so the whole
# flow is testable with no provider account and no domain. It is the default and
# it is NOT production-ready: nothing is delivered.
# Free tiers that are: Resend (3,000/month) and Brevo via SMTP (300/day).
EMAIL_PROVIDER=console
EMAIL_FROM=Memoize <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Distinct problems a signed-out visitor may run before being asked to sign in.
# A nudge, not a boundary: clearing site data resets it.
GUEST_PROBLEM_LIMIT=2

# ---- Frontend (Vite: only VITE_* is exposed to the browser) ----
# Always ends in /api: served from one origin, `/problems` is both a page and an
# endpoint, so the API takes the prefix and the pages keep the clean URLs. The
# deployed build uses the relative "/api"; local Vite points across the port.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=true

# ---- Deployment ----
# Nothing below is needed locally. The full runbook is docs/DEPLOY.md; this is
# the summary of what changes when the app stops being localhost.
#
# The shape: ONE service serving both the API and the built frontend, and an
# external Postgres. Both halves of that are forced.
#
#   * One origin, because `onrender.com` is on the Public Suffix List — so
#     app.onrender.com and api.onrender.com are different *sites*, and the
#     SameSite=Lax session cookie is not sent between them. Sign-in would appear
#     to succeed and every following request would arrive signed out. Setting
#     COOKIE_SAMESITE=none avoids that but makes it a third-party cookie, which
#     Safari blocks outright. A custom domain (app.you.com + api.you.com) is the
#     other honest fix. The backend warns at boot if you get this wrong.
#   * External Postgres, because Render's own free database expires 30 days
#     after creation. Neon's free tier does not, and carries pgvector.
#
# Set FRONTEND_DIST only if the build lands somewhere other than frontend/dist;
# the backend serves it when the directory exists and ignores it when it does
# not, so local development is unaffected.
FRONTEND_DIST=
#
# On Render, PUBLIC_APP_URL and PUBLIC_API_URL both default to the injected
# RENDER_EXTERNAL_URL, so leave them unset unless you add a custom domain.
# CORS_ORIGINS should be empty for a single-origin deployment: there is no
# cross-origin caller to allow, and an empty list says so.
