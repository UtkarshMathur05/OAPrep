# Only VITE_* reaches the browser. Never put a key here.

# Ends in /api: every endpoint carries that prefix, because the deployed build
# is served from the same origin as the API and `/problems` is a page as well as
# an endpoint. Deployed this is the relative "/api"; here it points across the
# port at the backend.
VITE_API_BASE_URL=http://localhost:8000/api

# true → the UI resolves from src/data/mockData.ts and needs no backend at all.
# Auth is deliberately never mocked: a fake sign-in that always succeeds is
# worse than no sign-in.
VITE_USE_MOCK=true
